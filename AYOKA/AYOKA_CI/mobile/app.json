{
  "expo": {
    "name": "AYOKA CI",
    "slug": "ayoka-ci",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1F44"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.ayoka.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1F44"
      },
      "package": "ci.ayoka.app"
    },
    "extra": {
      "eas": {
        "projectId": "ayoka-ci"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
